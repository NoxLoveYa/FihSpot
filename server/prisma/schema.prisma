generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String?
  googleId      String?    @unique
  name          String
  avatarUrl     String?
  role          Role       @default(USER)
  searchEnabled Boolean    @default(false)
  createdAt     DateTime   @default(now())
  pois          PoI[]
  comments      Comment[]
  photos        Photo[]
  searches      Search[]
  seenPois      SeenPoi[]
}

model PoI {
  id          String    @id @default(cuid())
  name        String
  description String?
  lat         Float
  lng         Float
  category    String?
  demo        Boolean   @default(false)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]
  photos      Photo[]
  seenBy      SeenPoi[]

  @@index([lat, lng])
}

model Search {
  id        String   @id @default(cuid())
  name      String
  lat       Float
  lng       Float
  zoom      Int      @default(14)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SeenPoi {
  userId  String
  poiId   String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poi     PoI      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  seenAt  DateTime @default(now())

  @@id([userId, poiId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  poiId     String
  poi       PoI      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([poiId])
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  poiId     String
  poi       PoI      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([poiId])
}
