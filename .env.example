# Server
PORT=3000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://fihspot:fihspot@localhost:5432/fihspot
# Required in production: at least 32 characters — the server refuses to boot otherwise
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated list of emails that are automatically promoted to admin
ADMIN_EMAILS=

# Docker compose (db + server). Defaults keep the historical fihspot/fihspot
# credentials; override before the first `docker compose up` so the data
# volume is initialized with a real password.
POSTGRES_USER=fihspot
POSTGRES_PASSWORD=fihspot
POSTGRES_DB=fihspot

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps Static API (server-side tile cache for the spot scan).
# IP-restricted server key; serves scan tiles via our server instead of the client.
GOOGLE_MAPS_SERVER_KEY=

# Google Maps JavaScript API (used by the client via VITE_*)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
