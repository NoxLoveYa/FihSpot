{
	# Only HTTP/1.1 to clients. Mobile carriers' NAT drops idle connections, and
	# iOS standalone apps over cellular fail with "network connection lost" when
	# they reuse a stale HTTP/2 connection from another process. HTTP/3 (QUIC)
	# is also disabled for the same reason: a fresh TCP connection per launch is
	# the reliable path on mobile networks.
	servers :443 {
		protocols h1
	}
}

fihspot.com {
	reverse_proxy client:80
}

www.fihspot.com {
	redir https://fihspot.com{uri} permanent
}
